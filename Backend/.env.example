PORT=5000
NODE_ENV=development
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/Citizen_Police_Portal
# MongoDB Atlas (online):
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/Citizen_Police_Portal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/Citizen_Police_Portal
JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN=15m
DEFAULT_USER_PASSWORD=11223344
# Tabaarak SMS Gateway — https://sms.tabaarak.com
# Login: POST /Auth/SMSLogin  body: { "Name": "...", "Password": "..." }
# Send:  POST /Sms/sendsms     body: { "smsMessage": "...", "mobile": ["61xxxxxxx"] }
# Optional: TABAARAK_SMS_MOBILE_FORMAT=252  → sends as 25261xxxxxxx
TABAARAK_SMS_USERNAME=YOUR_USERNAME
TABAARAK_SMS_PASSWORD="YOUR_PASSWORD"
TABAARAK_SMS_MOBILE_FORMAT=252

# Google Gemini (Admin Chatbot) — paste your free API key from Google AI Studio
# https://aistudio.google.com/apikey
# New keys start with AQ. (auth keys). Restart backend after changing.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
